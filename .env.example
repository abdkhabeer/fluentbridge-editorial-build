# Instructor dashboard (/instructor). Never reuse production values in previews.
#
# Production deploy context only (Netlify: Site configuration > Environment
# variables, scope "Functions", deploy context "Production"):
INSTRUCTOR_PASSWORD=
INSTRUCTOR_SESSION_SECRET=
#
# Deploy previews / branch deploys only (deploy contexts "Deploy Previews" and
# "Branch deploys"). Must differ from the production values; if they match,
# the preview dashboard refuses to start.
PREVIEW_INSTRUCTOR_PASSWORD=
PREVIEW_INSTRUCTOR_SESSION_SECRET=
#
# Password: at least 12 characters (use 20+ random characters).
# Secret: at least 32 random characters, e.g. `openssl rand -hex 32`.
#
# Local `npm run dev` reads INSTRUCTOR_PASSWORD / INSTRUCTOR_SESSION_SECRET from
# .env.local and stores data in .data/ (never Netlify).
#
# Feature flags and settings (Netlify scope: Builds, plus Functions where noted).
# Set to "true" to turn a flag on. All default to off.
#
# Adds the trial refund promise to follow-up message 3 and the results page.
FEATURE_TRIAL_REFUND_COPY=
# Promises a writing review within 24 hours on the results page.
FEATURE_REVIEW_SLA_COPY=
# Stores first-touch attribution on new leads (Builds AND Functions).
# Keep off until the consent wording in docs/analytics.md is approved.
FEATURE_LEAD_ATTRIBUTION=
# Trial booking page (https only). When unset, "Book my trial" opens WhatsApp.
BOOKING_URL=
#
# New-lead alert email through Resend (Netlify scope: Functions). Off unless
# both RESEND_API_KEY and ALERT_EMAIL_TO are set. See docs/email-alerts.md.
RESEND_API_KEY=
ALERT_EMAIL_TO=
# Defaults to onboarding@resend.dev, which delivers only to the Resend account's
# own email address. Use an address on a verified domain, for example
# "FluentBridges <alerts@mail.fluentbridges.com>".
EMAIL_FROM=
